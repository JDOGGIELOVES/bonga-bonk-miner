# Solana RPC endpoint (required for wallet balance & future on-chain claims)
# Get a free key at https://helius.dev or https://alchemy.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Network: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# NFT Minting (Bonga NFT Collection)
NEXT_PUBLIC_MINT_PRICE_SOL=0.08
NEXT_PUBLIC_MINT_SIMULATED=true
# When ready for on-chain minting:
# NEXT_PUBLIC_MINT_SIMULATED=false
# NEXT_PUBLIC_CANDY_MACHINE_ADDRESS=your_candy_machine_pubkey
# NEXT_PUBLIC_COLLECTION_ADDRESS=your_collection_pubkey