# Solana RPC — REQUIRED for production claims (public RPC rate-limits fast)
# Get a free key: https://helius.dev or https://quicknode.com
# Multiple URLs (comma-separated) are retried on rate limit:
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Network: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# ── $BONGA Treasury (on-chain claims) ─────────────────────────────
# Generate wallet: node scripts/setup-treasury.mjs
# Fund treasury with SOL (fees) + $BONGA SPL tokens before enabling.

# SPL mint address for $BONGA token
BONGA_MINT_ADDRESS=7YoAymCyauHAXus3snMEKcLgRx546MrHuBW3EuUNKKQs
NEXT_PUBLIC_BONGA_MINT_ADDRESS=7YoAymCyauHAXus3snMEKcLgRx546MrHuBW3EuUNKKQs

# Treasury public key (safe to expose)
TREASURY_PUBLIC_KEY=
NEXT_PUBLIC_TREASURY_PUBLIC_KEY=

# Treasury private key — SERVER ONLY, add in Vercel env (never commit)
TREASURY_PRIVATE_KEY=

# Token decimals (usually 6 or 9 for SPL tokens)
BONGA_TOKEN_DECIMALS=9

# Set true only after treasury is funded and mint is configured
ON_CHAIN_CLAIMS_ENABLED=false
NEXT_PUBLIC_ON_CHAIN_CLAIMS_ENABLED=false

# Emergency stop for all on-chain claims (miner + pet)
CLAIMS_PAUSED=false

# REQUIRED to send any $BONGA from treasury — leave unset/false during incidents
# CLAIMS_PAYOUTS_UNLOCKED=true

# Pet Love only — paused by default until you set PET_LOVE_CLAIMS_PAUSED=false
PET_LOVE_CLAIMS_PAUSED=true

# Per-IP anti-abuse (hashed IPs stored in Vercel Blob — set false to disable)
CLAIM_IP_LIMITS_ENABLED=true
CLAIM_MAX_WALLETS_PER_IP_DAY=3
CLAIM_MAX_BONGA_PER_IP_DAY=130
CLAIM_MAX_PET_CLAIMS_PER_IP_DAY=1
CLAIM_MAX_MINER_CLAIMS_PER_IP_DAY=3
CLAIM_MAX_TAPS_PER_IP_DAY=3500
CLAIM_MIN_MS_BETWEEN_IP=30000
# Optional salt for IP hashing (change if rotating)
CLAIM_IP_HASH_SALT=

# Max $BONGA per wallet per UTC day (Pet Love uses 100 — set 100+ if using both)
DAILY_CLAIM_LIMIT=100

# ── Pet Love gallery + claims (REQUIRED on Vercel) ─────────────────
# Vercel Dashboard → Storage → Create Blob → Connect to this project.
# OIDC (default): BLOB_STORE_ID + VERCEL_OIDC_TOKEN (auto on deploy).
# Legacy: BLOB_READ_WRITE_TOKEN (long-lived token).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
# If your Blob store is private, set: BLOB_DEFAULT_ACCESS=private
BLOB_DEFAULT_ACCESS=

# ── Telegram Daily Affirmation Bot ────────────────────────────────
# Create via @BotFather → paste token here and in Vercel env.
TELEGRAM_BOT_TOKEN=
# Channel or group chat ID for daily cron posts (bot must be admin in channels).
# Get ID: add bot, post once, visit /api/telegram/webhook logs or use @userinfobot.
TELEGRAM_CHAT_ID=
# Optional but recommended — set same value when running npm run telegram:setup
TELEGRAM_WEBHOOK_SECRET=
# Vercel Cron auth (Dashboard → Settings → Cron → CRON_SECRET, or generate your own)
CRON_SECRET=

# NFT Minting (Bonga NFT Collection)
NEXT_PUBLIC_SITE_URL=https://bongabonks.com
NEXT_PUBLIC_MINT_PRICE_SOL=0.08
NEXT_PUBLIC_MINT_SIMULATED=true
MINT_SIMULATED=true
# After: npm run nft:deploy (server reads MINT_SIMULATED at runtime — no rebuild needed)
# MINT_SIMULATED=false
# NEXT_PUBLIC_MINT_SIMULATED=false
# NEXT_PUBLIC_CANDY_MACHINE_ADDRESS=your_candy_machine_pubkey
# NEXT_PUBLIC_COLLECTION_ADDRESS=your_collection_pubkey
# NFT_DEPLOY_SUPPLY=8888