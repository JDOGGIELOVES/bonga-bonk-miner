# Telegram bot token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Group chat ID for morning posts to https://t.me/bonga_sol_community
# Leave blank at first. Start the bot, add it to the group, type /chatid there,
# copy the number it replies with, paste here, then restart.
# CHAT_ID=-1001234567890

# Daily post schedule — either HH:MM (24h) or a full cron expression
# HH:MM uses CRON_TIMEZONE below. Cron expressions use standard 5-field syntax.
CRON_TIME=08:00

# IANA timezone for HH:MM schedules (e.g. America/New_York, Europe/London, UTC)
CRON_TIMEZONE=UTC

# Comma-separated Telegram user IDs allowed to run /addaffirm
ADMIN_USER_IDS=123456789

# Optional branding links
SITE_URL=https://bongabonks.com
COMMUNITY_URL=https://t.me/bonga_sol_community